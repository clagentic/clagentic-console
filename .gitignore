# .crew/ contains crew dispatch config (naomi.yaml, amos.yaml, etc.) and IS
# intentionally tracked. Do not ignore the whole directory. If a specific
# crew artifact that contains secrets ever needs ignoring, add it by name
# (e.g. .crew/secrets.yaml), not by ignoring the whole .crew/ tree.
# Transient crew working files (PR bodies, temp payloads) are not config.
.crew/*.txt
.crew/*.json

# Scratch verification scripts/output left behind by AMoS build sessions —
# never part of the shipped tree, but easy to accidentally leave untracked.
scripts/__pycache__/
scripts/_*
scripts/pr-body-*.txt
scripts/smoke.sh
test-results/

