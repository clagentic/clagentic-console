{
  "name": "@clagentic/console",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.4.0-beta.2",
  "description": "Self-hosted console for Claude Code and Codex. Multi-user, browser-based, persistent AI sessions.",
  "bin": {
    "clagentic-console": "./bin/cli.js"
  },
  "scripts": {
    "dev": "node bin/cli.js --dev",
    "postinstall": "node scripts/postinstall.js",
    "test": "node --test --test-force-exit test/*.test.js",
    "semantic-release": "semantic-release"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "deploy/",
    "CREDITS.md"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "codex",
    "codex-cli",
    "openai",
    "self-hosted",
    "multi-user",
    "team",
    "workspace",
    "ai-agent",
    "ai-coding-agent",
    "clagentic",
    "cron",
    "mobile",
    "pwa",
    "web-ui",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clagentic/clagentic-console.git"
  },
  "bugs": {
    "url": "https://github.com/clagentic/clagentic-console/issues"
  },
  "homepage": "https://github.com/clagentic/clagentic-console#readme",
  "author": "Andy Kuehner",
  "contributors": [
    "Chad (original Clay author)"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.112",
    "@lydell/node-pty": "^1.2.0-beta.3",
    "@openai/codex": "^0.124.0",
    "nodemailer": "^6.10.1",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^25.0.3"
  }
}
